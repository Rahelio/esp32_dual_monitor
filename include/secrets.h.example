// Copy this file to secrets.h (same directory) and fill in real values.
// secrets.h is gitignored -- never commit your actual credentials.
#pragma once

#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// The aggregator's /status endpoint, e.g. http://192.168.1.50:8080/status
#define DASHBOARD_URL "http://192.168.1.50:8080/status"
// Must match DASHBOARD_API_KEY in the aggregator's .env
#define DASHBOARD_API_KEY "your-dashboard-api-key"

// Coordinates for weather (Open-Meteo), e.g. from https://www.latlong.net/
#define WEATHER_LAT "51.5074"
#define WEATHER_LON "-0.1278"